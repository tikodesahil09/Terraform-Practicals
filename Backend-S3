# Practical 01

# create new directory- dir1
# create new bucket- terraform-backend-bucket-sahilll

# 1) main.tf 

//backend
terraform {
  backend "s3" {
    bucket = "terraform-backend-bucket-sahilll"
    key = "terraform.tfstate"
    region = "eu-north-1"
  }
}

provider "aws" {
  region = var.region
}

resource "aws_instance" "new-ec2" {
  ami = var.image
  instance_type = var.instance_type
  vpc_security_group_ids = ["sg-0480ee3afa5758e19"]
  tags = {
    Name = "server1"
  }
}

# 2) variable.tf 

variable "region" {
  default = "eu-north-1"
}
variable "image" {
  default = "ami-0aaa636894689fa47"
}
variable "instance_type" {
  default = "t3.micro"
}

# Command :
  1. git init 
    (successfully attach bucket)
  2. git plan
  3. git apply --auto approve

# Then "terraform.tfstate" file and "terraform.tfstate.backup" file stored in s3 bucket


# IMP Command Usage :-

1) terraform state list
    : list all resources currently tracked within the Terraform state file.

2) terraform state show [resource_name]
    :  It gives detailed information about your resource

