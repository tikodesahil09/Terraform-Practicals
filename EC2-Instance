## Practical no 2

provider "aws" {
  region = "eu-north-1"
}

// Create 3 ec2 instance without name
resource "aws_instance" "first-example" {
  ami = "ami-073130f74f5ffb161"
  instance_type = "t3.micro"
  count = 3
}
OR
// Create 3 ec2 instance with name
resource "aws_instance" "first-example" {
  ami = "ami-073130f74f5ffb161"
  instance_type = "t3.micro"

  count = 3
  tags = {
    Name = "example${count.index +1}"
  }
}


## Practical no 3

provider "aws" {
  region = "eu-north-1"
}

// Create Ec2 and Attach New Security Group 
resource "aws_instance" "first-instance" {

  ami = "ami-056335ec4a8783947"
  instance_type = "t3.micro"
  key_name = "jenkins"
  vpc_security_group_ids = [ aws_security_group.first-sg.id ]
  tags = {
    Name = "webserver"
  }
}

// Create New Security Group
resource "aws_security_group" "first-sg" {
  name = "my-sg"  /*once name is given, it cannot be changed.*/
  ingress {
    description = "allow ssh"
    to_port = 22
    from_port = 22
    protocol = "tcp"
    cidr_blocks = [ "0.0.0.0/0" ]
  }
