## Practical No 1 

//using iam user credentials
provider "aws" {
  region = "eu-north-1"
  access_key = "xyz"
  secret_key = "abc"
}
OR
//using attach iam role
provider "aws" {
  region = "eu-north-1"
}

// Create ec2 instance
resource "aws_instance" "first-example" {
  ami = "ami-073130f74f5ffb161"
  instance_type = "t3.micro"

  tags = {
    Name = "first-instance"
  }
}

END


## Practical no 2

provider "aws" {
  region = "eu-north-1"
}

// Create 3 ec2 instance
resource "aws_instance" "first-example" {
  ami = "ami-073130f74f5ffb161"
  instance_type = "t3.micro"

  count = 3
  tags = {
    Name = "example${count.index +1}"
  }
}
