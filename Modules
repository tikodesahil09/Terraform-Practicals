1)
main.tf :

    provider "aws" {
      region = "us-east-1"
    }
    
    module "vpc" {
      source = "./modules/vpc"
    }
    
    module "ec2" {
      source = "./modules/ec2"
      subnet_id = module.vpc.subnet_id
      vpc_id = module.vpc.vpc_id
    }


2) ec2 :-

main.tf :

    resource "aws_security_group" "main-sg" {
    vpc_id = var.vpc_id
    ingress {
      from_port = 22
      to_port = 22
      protocol = "tcp"
      cidr_blocks = ["0.0.0.0/0"]
    }
    ingress {
      from_port = 80
      to_port = 80
      protocol = "tcp"
      cidr_blocks = ["0.0.0.0/0"]
    }
    egress {
      from_port = 0
      to_port = 0
      protocol = "-1"
      cidr_blocks = ["0.0.0.0/0"]
      }
    }
  
    resource "aws_instance" "main-ec2" {
      ami = var.image
      instance_type = var.type
      subnet_id = var.subnet_id
      vpc_security_group_ids = [aws_security_group.main-sg.id]
      tags = {
        Name = "server"
       }
    }

variable.tf :

    variable "vpc_id" {
      description = "Enter VPC"
    }
    
    variable "image" {
      default = "ami-0ec10929233384c7f"
    }
    
    variable "type" {
      default = "t3.micro"
    }
    
    variable "subnet_id" {
      description = "Enter Subnet"
    }


3) vpc :-

main.tf :

    resource "aws_vpc" "main-vpc" {
      cidr_block = var.vpc_cidr
      tags = {
        Name = "terra-vpc"
      }
    }
    
    resource "aws_subnet" "vpc-sub" {
      vpc_id = aws_vpc.main-vpc.id
      cidr_block = var.sub_cidr
      availability_zone = var.sub_az
      tags = {
        Name = "public-subnet"
      }
      map_public_ip_on_launch = true
    }
    
    resource "aws_internet_gateway" "vpc-igw" {
      vpc_id = aws_vpc.main-vpc.id
      tags = {
        Name = "terra-igw"
      }
    }
    
    resource "aws_route_table" "vpc-route" {
      vpc_id = aws_vpc.main-vpc.id
      route {
        cidr_block = "0.0.0.0/0"
        gateway_id = aws_internet_gateway.vpc-igw.id
      }
    }
    
    resource "aws_route_table_association" "route-asso" {
      subnet_id = aws_subnet.vpc-sub.id
      route_table_id = aws_route_table.vpc-route.id
    }

variable.tf :

    variable "vpc_cidr" {
      default = "10.0.0.0/16"
    }
    
    variable "sub_cidr" {
      default = "10.0.0.0/20"
    }
    
    variable "sub_az" {
      default = "us-east-1a"
    }

output.tf : 

    output "subnet_id" {
      value = aws_subnet.vpc-sub.id
    }
    
    output "vpc_id" {
      value = aws_vpc.main-vpc.id
    }   

